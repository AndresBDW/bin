#!/bin/sh
# kiss hook, adaptado al kiss actual (kisslinux/kiss: corre los
# hooks como procesos aparte, no los sourcea).
#
# Recibe: $1=TYPE $2=PKG $3=DEST-o-ruta-relacionada.
#
# LO QUE UN HOOK ACA NO PUEDE HACER (y por qué):
#   - MAKEFLAGS por paquete: lo que el hook exporte muere con su
#     propio proceso, nunca llega al build real.
#   - Activar tmpfs por paquete: mak_dir/pkg_dir los fija kiss una
#     sola vez al arrancar (create_tmp_dirs), antes de que corra
#     ningún hook. No hay forma de cambiarlos por paquete desde acá.
# Para ambas cosas, la solución real es la función de shell "kb"
# que te dejo abajo del hook, comentada, que decide esto ANTES de
# invocar kiss (no desde adentro).

TYPE=$1
PKG=$2
DEST=$3

# Colores iguales a los de kiss (mismo criterio: KISS_COLOR y tty).
if [ "${KISS_COLOR:-1}" != 0 ] && [ -t 2 ]; then
    c1='\033[1;33m'
    c2='\033[1;34m'
    c3='\033[m'
fi

log() {
    printf '%b%s %b%s%b %s\n' \
        "$c1" "->" "${c3}${2:+$c2}" "$1" "$c3" "$2" >&2
}

_timefile=${KISS_TMPDIR:-/tmp}/_kh_start-$PKG

case $TYPE in
    pre-build)
        cat /proc/uptime > "$_timefile" 2>/dev/null

        case $PKG in
            mesa)
                _flags=-Dgallium-drivers=radeonsi
                _flags=$_flags\ -Dvulkan-drivers=amd
                _flags=$_flags\ -Dvideo-codecs=all

                sed -i "s/\. output/$_flags \0/" .build
            ;;
        esac
    ;;

    post-build)
        if [ -f "$_timefile" ]; then
            IFS=. read -r _start _ < "$_timefile"
            IFS=. read -r _end _ < /proc/uptime
            rm -f "$_timefile"

            _s=$((_end - _start))
            _h=$((_s / 60 / 60 % 24))
            _m=$((_s / 60 % 60))

            [ "$_h" = 0 ] || _u="${_u}${_h}h "
            [ "$_m" = 0 ] || _u="${_u}${_m}m "

            log "$PKG" "Build finished in ${_u:-${_s}s}"
        fi

        case $PKG in
           kiss) rm -rf "$DEST/usr/bin" ;;

           *)
               rm -rf "$DEST/usr/share/doc"
               rm -rf "$DEST/usr/share/gettext"
               rm -rf "$DEST/usr/share/man"
               rm -rf "$DEST/usr/share/locale"
               rm -rf "$DEST/usr/share/polkit-1"
               rm -rf "$DEST/usr/share/info"
               rm -rf "$DEST/usr/share/gtk-doc"
               rm -rf "$DEST/usr/share/zsh"
               rm  -f "$DEST/usr/lib/charset.alias"
           ;;
        esac
    ;;
esac

# --- MAKEFLAGS y tmpfs por paquete: hacelo así, no desde el hook ---
# Poné esto en tu .profile (o donde tengas tu shell rc):
#
#   kb() {
#       case $1 in
#           llvm|clang|rust|rustc|gcc)
#               MAKEFLAGS=-j6 kiss b "$@" ;;
#           *)
#               KISS_TMPDIR=/tmp/kiss-tmp kiss b "$@" ;;
#       esac
#   }
#
# y usás "kb pfetch" o "kb llvm" en vez de "kiss b ...".
